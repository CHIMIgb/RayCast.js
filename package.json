{
  "name": "raycast-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RayCast Studio — creador web de RPG 2.5D/3D retro (F0.5: backend Hono + Postgres + schema v2)",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:api:dev\" \"npm:web:dev\"",
    "web:dev": "vite",
    "api:dev": "tsx watch server/src/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
