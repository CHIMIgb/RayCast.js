# RayCast Studio — backend
# Copiar a .env y ajustar. Los valores de abajo son los defaults de dev.

# Postgres: en dev se usa PGlite embebido (pglite:./server/db/data) sin infraestructura.
# Producción/self-host: apuntar a un Postgres real, p.ej.
# DATABASE_URL=postgres://usuario:password@localhost:5432/raycast

PORT=3000
JWT_SECRET=dev-secret-change-me
DATABASE_URL=pglite:./server/db/data