# RayCast Studio — backend
# Copiar a .env y ajustar. Los valores de abajo son los defaults de dev.

# Postgres: se usa PostgreSQL real con Prisma ORM (dev, staging y prod).
# Levantar una instancia local de Postgres, p.ej. con el docker-compose.yml:
#   docker compose up -d db
# y apuntar DATABASE_URL a esa instancia.

PORT=3000
JWT_SECRET=dev-secret-change-me
DATABASE_URL=postgres://raycast:raycast@localhost:5432/raycast
